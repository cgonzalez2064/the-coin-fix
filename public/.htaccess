Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
# Enable only AFTER a valid SSL certificate is installed.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# UI navigation uses state, so no SPA catch-all is needed.
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set X-Frame-Options "DENY"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://open.er-api.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; worker-src 'self'; manifest-src 'self'"
<FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "^.*-[a-zA-Z0-9_-]{8,}\.(js|css)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
<FilesMatch "(^\.|\.env|\.backup\.json$|package.*\.json$)">
Require all denied
</FilesMatch>
