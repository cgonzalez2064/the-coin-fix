{
  "name": "the-coin-fix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run test:auth && npm run build",
    "build:public": "tsc -b && vite build --mode public",
    "auth": "node --env-file-if-exists=.env server/index.mjs",
    "auth:seed": "node --env-file-if-exists=.env server/seed.mjs",
    "test:auth": "node --test server/*.test.mjs",
    "db:check": "node --env-file-if-exists=.env scripts/check-database.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.12 <25"
  }
}
